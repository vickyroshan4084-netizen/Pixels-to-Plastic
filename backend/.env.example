# ─── P2P Local Environment ────────────────────────────────────────────────────
# Rename this file to  .env  (remove the .example part)
# Then fill in your actual values below.

SECRET_KEY=django-insecure-p2p-change-this-string-to-something-random

# Set to True while developing locally
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Razorpay (get free TEST keys from razorpay.com) ─────────────────────────
# Dashboard → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_PASTE_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PASTE_YOUR_SECRET_KEY_HERE

# ─── Google Pay / UPI ────────────────────────────────────────────────────────
# Your registered UPI ID (found in any UPI app under Profile)
GPAY_UPI_VPA=yourname@okaxis

# ─── Admin Registration Key ──────────────────────────────────────────────────
# This is the secret code required to register as admin
ADMIN_KEY=p2p_admin_2024

# ─── PostgreSQL (leave blank to use SQLite locally) ──────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/p2p_db
